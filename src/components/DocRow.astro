---
interface Props {
  href: string;
  title: string;
  desc: string;
  date: string;
  cat?: string;
  platform?: string;
  diff?: "Easy" | "Medium" | "Hard";
}
const { href, title, desc, date, cat, platform, diff } = Astro.props;

const pilule = "inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-xs";
const pastille = { Easy: "bg-easy", Medium: "bg-medium", Hard: "bg-hard" } as const;

/** Même carte pour les write-ups et les notes, comme les autres cartes du site : coins de 14 px, ombre légère. */
const cadre = "grid grid-cols-1 gap-[7px] rounded-[14px] px-4 py-[14px] shadow-[var(--shadow-sm)] md:gap-6 md:px-[18px] md:py-4";
---

<a
  href={href}
  class:list={[
    "border border-border bg-card transition-colors hover:border-border-hover hover:bg-surface-hover md:grid-cols-[minmax(0,1fr)_auto] md:items-start",
    cadre
  ]}
>
  <div class="flex min-w-0 flex-col gap-[7px]">
    <!-- Sur mobile, la date est à droite du titre ; sur ordinateur, dans sa colonne à droite de la carte. -->
    <div class="flex items-baseline justify-between gap-3">
      <span class="min-w-0 text-[15px] font-medium tracking-[-0.01em]">{title}</span>
      <span class="shrink-0 font-mono text-xs whitespace-nowrap text-muted-foreground md:hidden">{date}</span>
    </div>
    <span class="text-sm leading-[1.6] text-muted-foreground">{desc}</span>
    <!-- Sur mobile, faute de place, la catégorie se raccourcit (…) avant que les badges passent à la ligne ; ils n'y passent que sous 3,5 rem de catégorie (très petits écrans). -->
    <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
      {
        cat && (
          <span class={`${pilule} min-w-0 max-w-max flex-[1000_1_3.5rem] border border-brand-line bg-brand-tint text-brand-text md:flex-none`}>
            <span class="truncate">{cat}</span>
          </span>
        )
      }
      {platform && <span class={`${pilule} shrink-0 border border-border text-muted-foreground`}>{platform}</span>}
      {
        diff && (
          <span class={`${pilule} shrink-0 gap-[5px] border border-border text-muted-foreground`}>
            <span class={`size-1.5 shrink-0 rounded-full ${pastille[diff]}`} />
            {diff}
          </span>
        )
      }
    </div>
  </div>
  <span class="hidden pt-0.5 font-mono text-xs whitespace-nowrap text-muted-foreground md:block">{date}</span>
</a>
