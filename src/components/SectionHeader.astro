---
import { ArrowRight } from "@lucide/astro";

interface Props {
  title: string;
  href: string;
}
const { title, href } = Astro.props;
---

<div class="flex items-center justify-between">
  <h2 class="m-0 text-[17px] font-semibold tracking-[-0.02em] md:text-lg">{title}</h2>
  <a
    href={href}
    class="controle inline-flex h-[42px] shrink-0 items-center gap-1.5 rounded-lg border border-border px-3 text-[13px] font-medium whitespace-nowrap transition-colors hover:bg-muted md:h-8"
  >
    Tout voir
    <ArrowRight size={14} />
  </a>
</div>
